# Copia este contenido en Streamlit Community Cloud:
# App > Settings > Secrets
#
# DEPLOYMENT_MODE fuerza el modo nube. Si se omite, la app intenta detectar
# si la URL pública es un dominio remoto y, si no, usa el modo LAN.
DEPLOYMENT_MODE = "cloud"

# TURN propio (recomendado para WebRTC en la nube).
# Descomenta y reemplaza con credenciales de Metered/Twilio o tu coturn.
# TURN_URL = "turn:TU_TURN_HOST:80,turns:TU_TURN_HOST:443"
# TURN_USERNAME = "TU_USUARIO"
# TURN_PASSWORD = "TU_PASSWORD"

# STUN opcional. Si se omite, se usan servidores STUN públicos por defecto.
# STUN_URL = "stun:stun.l.google.com:19302"
